{
  "name": "@ogna/js",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "Official lightweight JavaScript & TypeScript SDK for OgnaStack (Auth, Storage, and API Gateway)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "esbuild src/index.ts --bundle --platform=neutral --target=es2020 --outfile=dist/index.cjs --format=cjs",
    "build:esm": "esbuild src/index.ts --bundle --platform=neutral --target=es2020 --outfile=dist/index.mjs --format=esm",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "test": "npm run build:cjs && node --test tests/*.test.cjs",
    "lint": "eslint 'src/*'",
    "format": "prettier --write \"src/**/*.{js,ts,json}\""
  },
  "keywords": [
    "ognastack",
    "ogna",
    "sdk",
    "auth",
    "gotrue",
    "storage",
    "typescript",
    "javascript"
  ],
  "author": "OgnaStack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ognastack/ogna-js.git"
  },
  "bugs": {
    "url": "https://github.com/ognastack/ogna-js/issues"
  },
  "homepage": "https://github.com/ognastack/ogna-js",
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
